# ──────────────────────────────────────────────────────────────────
# NIRMAN AI — Environment Configuration
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────

# ── VLM Settings ──────────────────────────────────────────────────
# Choose: gemini  (recommended, free tier available)
#      or openai  (GPT-4o)
VLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── MongoDB Atlas (Free M0 Cluster) ───────────────────────────────
# 1. Go to https://cloud.mongodb.com  →  Sign up free
# 2. Create a FREE M0 cluster (us-east-1 or closest region)
# 3. Database Access  →  Add user  →  Password auth  →  note user/pass
# 4. Network Access   →  Add IP   →  Allow from anywhere (0.0.0.0/0)
# 5. Connect          →  Drivers  →  Python  →  Copy connection string
# 6. Replace <username> and <password> in the string below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=nirman-ai
MONGODB_DB=nirman_ai

# ── Blender ───────────────────────────────────────────────────────
# Windows example: C:\Program Files\Blender Foundation\Blender 4.1\blender.exe
# Linux / Docker:  /usr/bin/blender
BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 4.1\blender.exe
BLENDER_EXECUTION_MODE=local   # local (installed Blender) or docker
DOCKER_IMAGE=nirman-blender:latest
DOCKER_TIMEOUT=300

# ── Generation ────────────────────────────────────────────────────
GENERATION_CANDIDATES=3
MAX_RETRIES=3
MAX_CORRECTION_ATTEMPTS=2

# ── Paths ─────────────────────────────────────────────────────────
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# ── Verification thresholds ───────────────────────────────────────
MIN_DOOR_WIDTH=0.8
MIN_DOOR_HEIGHT=2.0
